# NEXUS environment template — copy to `.env` and fill in locally.
#
#   cp .env.example .env      # .env is git-ignored; never commit real values
#
# RULES (Section 13.3, D-019):
# - This file must never contain a real secret. Real secrets go in OpenBao or a
#   SOPS+age encrypted file, and are referenced by *name* only.
# - Venue API keys are never needed for market data. Phase 3 reads **public, unauthenticated**
#   endpoints only (D-026), so nothing below this line unlocks a feed. Trading keys stay
#   commented out until Phase 4+.
# - Live trading cannot be enabled from this file alone: it also needs the phase gate,
#   venue certification, an active mandate, and a runtime halt check.

# ---------------------------------------------------------------- host / edge
# Hostname Caddy serves. Leave blank for local :80 testing.
NEXUS_HOST=

# ---------------------------------------------------------------- NEXUS core
# Rollout stage: DISABLED | OBSERVE | RESEARCH | SHADOW | PAPER | PILOT | LIVE
# Phase 2 stays DISABLED. Unknown values fall back to DISABLED (fail closed).
NEXUS_ENVIRONMENT=DISABLED

# Hard-off until Phases 0-9 gates pass + Nigerian legal review (O-004) + owner approval.
NEXUS_LIVE_TRADING_ENABLED=false
NEXUS_LEGAL_REVIEW_COMPLETE=false
NEXUS_OWNER_LIVE_AUTHORITY_GRANTED=false

# Storage. SQLite is the $0 single-host default; Postgres is used in compose.
NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus:CHANGE_ME@db:5432/nexus

# Event bus. Empty means the in-memory bus (dev/tests); NATS in compose.
NEXUS_NATS_URL=
# NEXUS_NATS_URL=nats://nats:4222

# Secrets backend: env | sops | openbao   (all free/OSS; no cloud KMS)
NEXUS_SECRETS_BACKEND=env
# NEXUS_SECRETS_SOPS_FILE=/run/secrets/nexus.enc.yaml

# Audit backend for the API's default store: sqlite | memory
NEXUS_AUDIT_BACKEND=sqlite

# ---------------------------------------------------------------- risk (PROVISIONAL, O-002)
# Conservative owner profile (D-006). Hard limits override any model output.
NEXUS_RISK_MAX_RISK_PER_TRADE_PCT=1.0
NEXUS_RISK_MAX_LEVERAGE=2.0
NEXUS_RISK_DAILY_DRAWDOWN_HALT_PCT=2.0
NEXUS_RISK_MAX_OPEN_POSITIONS=10
NEXUS_RISK_MAX_NOTIONAL_PER_POSITION_USD=25000
NEXUS_RISK_MAX_PORTFOLIO_NOTIONAL_USD=100000
NEXUS_RISK_MAX_SINGLE_INSTRUMENT_EXPOSURE_PCT=10.0
NEXUS_RISK_MAX_CORRELATED_EXPOSURE_PCT=25.0

# ---------------------------------------------------------------- data quality
NEXUS_DATA_MAX_QUOTE_AGE_SECONDS=5
NEXUS_DATA_MAX_BOOK_AGE_SECONDS=10
NEXUS_DATA_MAX_ACCOUNT_SNAPSHOT_AGE_SECONDS=60

# ---------------------------------------------------------------- currency (D-025)
# All equity, sizing and risk math runs in USD. NGN is a **reporting** currency shown
# alongside for tax/ISA purposes and is never used to compute a limit, so a missing or
# stale NGN rate cannot loosen risk. If no free NGN rate is available the NGN column must
# read UNAVAILABLE — never an estimate, never a stale figure.
NEXUS_BASE_CURRENCY=USD
NEXUS_REPORTING_CURRENCY=NGN

# ---------------------------------------------------------------- market data (Phase 3)
# First-party archive root. Parquet + zstd, Hive-partitioned, never overwritten in place.
# This is the system's memory and the only series it can prove is complete.
NEXUS_ARCHIVE_ROOT=./data/archive

# Free, public, unauthenticated sources. Comma-separated; empty disables ingestion entirely.
# None of these can place an order and none takes a credential (D-019, D-026).
#   bybit-public     Bybit V5 public REST
#   okx-public       OKX v5 public REST
#   binance-vision   data.binance.vision bulk dumps (historical; NOT a venue connection)
#   dukascopy        Dukascopy free bi5 FX tick history (layout UNVERIFIED — see O-010)
NEXUS_DATA_SOURCES_ENABLED=bybit-public,okx-public,binance-vision,dukascopy

# ---------------------------------------------------------------- alerts (D-020)
# Free channels only. SMS and WhatsApp are BLOCKED by D-019 and have no setting.
NEXUS_ALERTS_TELEGRAM_ENABLED=true
NEXUS_ALERTS_WEBPUSH_ENABLED=true
NEXUS_ALERTS_EMAIL_ENABLED=true
NEXUS_ALERTS_IN_APP_ENABLED=true
NEXUS_ALERTS_EMAIL_DAILY_BUDGET=250

# ---------------------------------------------------------------- models (Q-06 default)
NEXUS_MODEL_LOCAL_FIRST=true
NEXUS_MODEL_ALLOW_FREE_HOSTED_APIS=true
NEXUS_MODEL_ALLOW_PAID_APIS=false
NEXUS_MODEL_ABSTAIN_WHEN_UNAVAILABLE=true
NEXUS_MODEL_FORBID_SENSITIVE_DATA_TO_HOSTED_MODELS=true
NEXUS_MODEL_MAX_DAILY_HOSTED_REQUESTS=900

# ---------------------------------------------------------------- compose services
# Set these in .env with real random values (e.g. `openssl rand -hex 24`).
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
MINIO_ROOT_USER=nexus
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- secret references
# Values are resolved by the secrets provider from these *names*. In dev the env backend
# maps `owner/api-token` to NEXUS_SECRET_OWNER_API_TOKEN. Do not paste real keys into a
# committed file; put them in your shell profile, OpenBao, or a SOPS file.
# NEXUS_SECRET_OWNER_API_TOKEN=
# NEXUS_SECRET_ALERTS_TELEGRAM_BOT_TOKEN=
# NEXUS_SECRET_ALERTS_BREVO_API_KEY=
# NEXUS_SECRET_BYBIT_API_KEY=          # Phase 4+, trade-only scope, withdrawal disabled
# NEXUS_SECRET_BYBIT_API_SECRET=
# NEXUS_SECRET_OKX_API_KEY=            # Phase 4+, demo trading first
# NEXUS_SECRET_OKX_API_SECRET=
# NEXUS_SECRET_OKX_PASSPHRASE=
